# Copy to .env. Paths may be absolute or relative to this project folder.
RFP_APP_NAME=RFP Intelligence
RFP_HOST=127.0.0.1
RFP_PORT=8000
# Optional Docker host port; the container always listens on 8000.
# RFP_WEB_PORT=8001
RFP_DATA_DIR="Assignment-Data-Statements (AI Engineer-Emplay Inc)"
RFP_STORAGE_DIR=storage
RFP_OUTPUT_DIR=outputs
RFP_LOG_DIR=logs

# Local embedding model; downloaded into the ignored cache on first use.
RFP_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RFP_EMBEDDING_REVISION=d4aa6901d3a41ba39fb536a557fa166f842b0e09
RFP_EMBEDDING_CACHE_DIR=storage/models
RFP_EMBEDDING_BATCH_SIZE=4
RFP_EMBEDDING_DEVICE=cpu
RFP_EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
RFP_VECTOR_DB_DIR=storage/chroma
RFP_VECTOR_COLLECTION=rfp_chunks_bge_large_1024

# Hybrid retrieval. Candidate counts are separate from final top_k results.
RFP_SEARCH_MODE=hybrid
RFP_SEARCH_VECTOR_CANDIDATES=20
RFP_SEARCH_KEYWORD_CANDIDATES=20
RFP_SEARCH_VECTOR_WEIGHT=1
RFP_SEARCH_KEYWORD_WEIGHT=1
RFP_SEARCH_RRF_K=60
# QA: results per search and maximum queries in one additional search round.
RFP_QA_SEARCH_TOP_K=5
RFP_QA_MAX_FOLLOWUP_QUERIES=6
# JSON multipliers for extraction fields. {} disables all field boosts.
RFP_SEARCH_FIELD_KEYWORD_BOOSTS='{"Bid Number":1.5,"Model_no":1.5,"Part_no":1.5,"contact_info":1.5,"Product":1.5}'

# Local cross-encoder re-ranking, after RRF and before table reconstruction.
RFP_SEARCH_RERANK=true
RFP_SEARCH_RERANK_CANDIDATES=20
RFP_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RFP_RERANKER_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
RFP_RERANKER_CACHE_DIR=storage/models
RFP_RERANKER_DEVICE=cpu
RFP_RERANKER_BATCH_SIZE=16

# Groq model connection. Add your key only to your local .env.
RFP_GROQ_API_KEY=
RFP_LLM_MODEL=openai/gpt-oss-120b
RFP_LLM_TIMEOUT=30
RFP_LLM_MAX_TOKENS=4096
# Never commit API keys or your .env file.

# Browser upload limits: files per folder, bytes per file, bytes per folder.
RFP_UPLOAD_MAX_FILES=200
RFP_UPLOAD_MAX_FILE_BYTES=52428800
RFP_UPLOAD_MAX_BYTES=209715200
RFP_EMBEDDING_DIMENSIONS=1024

# Optional grouping experiment for newly indexed folders (default off).
RFP_INDEX_STRUCTURE_AWARE=false
